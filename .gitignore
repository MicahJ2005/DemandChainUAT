# This file is used for Git repositories to specify intentionally untracked files that Git should ignore. 
# If you are not using git, you can delete this file. For more information see: https://git-scm.com/docs/gitignore
# For useful gitignore templates see: https://github.com/github/gitignore

# Salesforce cache
.sf/
.sfdx/
.localdevserver/
deploy-options.json

# LWC VSCode autocomplete
**/lwc/jsconfig.json

# LWC Jest coverage reports
coverage/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependency directories
node_modules/

# Eslint cache
.eslintcache

# MacOS system files
.DS_Store

# Windows system files
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Local environment variables
.env

# Python Salesforce Functions
**/__pycache__/
**/.venv/
**/venv/

# Contains hardcoded credentials - never commit (rotate and move to a Named Credential)
force-app/main/default/classes/ConnectedAppAuthHandler.cls
force-app/main/default/classes/ConnectedAppAuthHandler.cls-meta.xml
# Uses ConnectedAppAuthHandler and contains an old access token in a comment
force-app/main/default/classes/RemoteCaseSubmitService.cls
force-app/main/default/classes/RemoteCaseSubmitService.cls-meta.xml

# Decks and exports with business data stay local
*.pptx

# Local Claude Code settings
.claude/
