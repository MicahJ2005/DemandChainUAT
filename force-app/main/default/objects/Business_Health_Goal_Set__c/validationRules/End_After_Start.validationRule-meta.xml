<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>End_After_Start</fullName>
    <active>true</active>
    <description>Effective End must be on or after Effective Start.</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Effective_End__c)), Effective_End__c &lt; Effective_Start__c)</errorConditionFormula>
    <errorDisplayField>Effective_End__c</errorDisplayField>
    <errorMessage>Effective End must be on or after Effective Start.</errorMessage>
</ValidationRule>
