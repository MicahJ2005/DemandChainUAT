<?xml version="1.0" encoding="UTF-8"?>
<FlexiPage xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Personal dashboards for individual contributors. Shows the running user only the My Work views their permission sets grant, built from their own records.</description>
    <flexiPageRegions>
        <itemInstances>
            <componentInstance>
                <componentInstanceProperties>
                    <name>mode</name>
                    <value>mywork</value>
                </componentInstanceProperties>
                <componentName>c:businessHealthPage</componentName>
                <identifier>c_businessHealthPage</identifier>
            </componentInstance>
        </itemInstances>
        <name>main</name>
        <type>Region</type>
    </flexiPageRegions>
    <masterLabel>My Work</masterLabel>
    <template>
        <name>flexipage:defaultAppHomeTemplate</name>
    </template>
    <type>AppPage</type>
</FlexiPage>
